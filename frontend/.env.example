# Copia este archivo como .env.local y completa los valores (nunca subas .env.local al repositorio).
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL del backend FastAPI, sin /api al final (p. ej. http://localhost:8000).
NEXT_PUBLIC_API_URL=

# true = usar datos simulados de lib/mocks.ts en lugar del backend.
# Si NEXT_PUBLIC_API_URL está vacía, también se usan los datos simulados.
# En modo simulado el rol sale del correo de la sesión: contiene "admin" -> admin,
# contiene "docente" -> docente; cualquier otro -> estudiante.
# Si además Supabase no está configurado, /login crea una sesión simulada (solo para desarrollo).
NEXT_PUBLIC_USAR_MOCKS=true
