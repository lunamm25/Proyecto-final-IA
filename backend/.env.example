DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# Bucket PRIVADO de Supabase Storage donde se guardan los PDF y ZIP de las entregas.
SUPABASE_BUCKET=entregas
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.1
GEMINI_API_KEY=
# Proveedor OpenAI-compatible (LLM_PROVIDER=openai_compat). Ej. Ollama: http://localhost:11434/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Modelos que el admin puede elegir para openai_compat, separados por coma (nombres sin espacios).
# Si queda vacío y LLM_PROVIDER=openai_compat, solo se permite LLM_MODEL.
OPENAI_COMPAT_MODELOS=
FRONTEND_URL=http://localhost:3000
# Ejecutar el código Python de las entregas en el sandbox al evaluar (true/false).
# Déjalo en false: el sandbox actual no limita memoria ni red. Solo se guarda un resumen
# (codigo_salida, tiene_error, ejecucion_exitosa), nunca stdout ni stderr.
VERIFICACION_ACTIVA=false
